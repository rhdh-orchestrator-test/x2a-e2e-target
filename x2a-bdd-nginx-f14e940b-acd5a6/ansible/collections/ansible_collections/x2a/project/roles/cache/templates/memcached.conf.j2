# Memcached configuration managed by Ansible.
-m {{ cache_memcached_memory }}
-p {{ cache_memcached_port }}
-U {{ cache_memcached_udp_port }}
-l {{ cache_memcached_listen }}
-c {{ cache_memcached_max_connections }}
-u {{ cache_memcached_user }}
-I {{ cache_memcached_max_object_size }}
{% if cache_memcached_threads is not none %}-t {{ cache_memcached_threads }}
{% endif %}{% for option in cache_memcached_experimental_options %}{{ option }}
{% endfor %}{% for option in cache_memcached_extra_cli_options %}{{ option }}
{% endfor %}