# Backend: {{ backend_name }}
# Managed by Ansible — do not edit manually

backend {{ backend_name }}
    balance {{ balance }}
{% if health_check %}
    option  {{ health_check }}
{% endif %}
{% if health_interval %}
    default-server inter {{ health_interval }}
{% endif %}
{% for item_server in servers %}
    server {{ item_server['name'] }} {{ item_server['address'] }}:{{ port }} check weight {{ item_server['weight'] }}{% if ssl_enabled %} ssl verify none{% endif %}
{% endfor %}
