[Unit]
Description=Redis persistent key-value database
After=network.target

[Service]
ExecStart={{ redis_install_dir | default('/usr/local/bin') }}/redis-server /etc/redis/{{ item.name | default(item.port) }}/redis.conf
ExecStop={{ redis_install_dir | default('/usr/local/bin') }}/redis-cli -p {{ item.port | default(6379) }} shutdown
User={{ redis_user | default('redis') }}
Group={{ redis_group | default('redis') }}
RuntimeDirectory=redis
RuntimeDirectoryMode=0755
LimitNOFILE={{ redis_nofile_limit | default('65536') }}

[Install]
WantedBy=multi-user.target