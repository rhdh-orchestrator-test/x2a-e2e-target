#!/bin/sh
#
# Simple Redis init.d script
# Generated by Ansible
#
### BEGIN INIT INFO
# Provides:          redis-{{ item.name | default(item.port) }}
# Required-Start:    $network $local_fs $remote_fs
# Required-Stop:     $network $local_fs $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Redis data structure server
# Description:       Redis is an open source, advanced key-value store.
### END INIT INFO

NAME="redis-{{ item.name | default(item.port) }}"
DAEMON="{{ redis_install_dir | default('/usr/local/bin') }}/redis-server"
DAEMON_ARGS="/etc/redis/{{ item.name | default(item.port) }}/redis.conf"
PIDFILE="/var/run/redis/{{ item.name | default(item.port) }}.pid"
USER="{{ redis_user | default('redis') }}"

[ -x $DAEMON ] || exit 0

case "$1" in
  start)
    echo -n "Starting $NAME: "
    mkdir -p $(dirname $PIDFILE)
    chown $USER $(dirname $PIDFILE)
    if start-stop-daemon --start --quiet --umask 007 --pidfile $PIDFILE --chuid $USER:$USER --exec $DAEMON -- $DAEMON_ARGS
    then
      echo "OK"
    else
      echo "failed"
    fi
    ;;
  stop)
    echo -n "Stopping $NAME: "
    if [ ! -f "$PIDFILE" ]
    then
      echo "not running"
    else
      PID=$(cat $PIDFILE)
      echo $PID
      if kill -TERM $PID
      then
        echo "OK"
      else
        echo "failed"
      fi
      rm -f $PIDFILE
    fi
    ;;
  restart|force-reload)
    ${0} stop
    ${0} start
    ;;
  status)
    echo -n "$NAME is "
    if [ ! -f "$PIDFILE" ]
    then
      echo "not running"
      exit 1
    else
      PID=$(cat $PIDFILE)
      if kill -0 $PID > /dev/null 2> /dev/null
      then
        echo "running"
      else
        echo "not running"
        exit 1
      fi
    fi
    ;;
  *)
    echo "Usage: /etc/init.d/$NAME {start|stop|restart|force-reload|status}" >&2
    exit 1
    ;;
esac

exit 0