# SSL Configuration Template for POODLE Fix
# This template provides secure SSL configuration to mitigate POODLE vulnerability

# SSL Protocol Configuration - Disable vulnerable protocols
SSLProtocol {{ apache_ssl_protocols | join(' ') }}

# Additional SSL hardening options
SSLCipherSuite ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256
SSLHonorCipherOrder on
SSLCompression off
SSLSessionTickets off

# HSTS (HTTP Strict Transport Security)
Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

# Disable SSL v2 and v3 explicitly
SSLProtocol all -SSLv2 -SSLv3

# Use secure renegotiation
SSLInsecureRenegotiation off