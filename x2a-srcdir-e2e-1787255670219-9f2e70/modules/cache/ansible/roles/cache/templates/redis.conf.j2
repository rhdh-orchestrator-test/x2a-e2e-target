# Redis configuration file
# Generated by Ansible

# Network
bind {{ cache_redis_bind_address }}
port {{ cache_redis_port }}

# General
daemonize yes
pidfile /var/run/redis/redis-server.pid

# Logging
logfile /var/log/redis/redis-server.log

# Persistence
dir /var/lib/redis
dbfilename dump.rdb

# Other common settings
timeout 0
tcp-keepalive 300
databases 16