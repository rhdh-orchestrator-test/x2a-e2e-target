server_tokens off;
limit_req_zone $binary_remote_addr zone=one:10m rate={{ nginx_multisite_request_rate }}r/s;
client_body_buffer_size {{ nginx_multisite_client_body_buffer_size }};
client_header_buffer_size {{ nginx_multisite_client_header_buffer_size }};
client_max_body_size {{ nginx_multisite_client_max_body_size }};
large_client_header_buffers 4 {{ nginx_multisite_large_client_header_buffer_size }};
client_body_timeout {{ nginx_multisite_client_body_timeout }};
client_header_timeout {{ nginx_multisite_client_header_timeout }};
send_timeout {{ nginx_multisite_send_timeout }};
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 10m;
ssl_ciphers {{ nginx_multisite_ssl_ciphers }};
ssl_prefer_server_ciphers on;
