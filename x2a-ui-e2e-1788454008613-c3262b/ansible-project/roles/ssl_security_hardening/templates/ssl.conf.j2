# SSL Configuration Template
# Generated by Ansible ssl_security_hardening role

# SSL Protocol Configuration - POODLE vulnerability mitigation
SSLProtocol -all {% for protocol in ssl_protocols %}{{ protocol }} {% endfor %}

# SSL Cipher Suite Configuration
SSLCipherSuite {{ ssl_cipher_suite }}
SSLHonorCipherOrder on

# SSL Engine
SSLEngine on

# SSL Certificate Configuration (customize as needed)
# SSLCertificateFile /path/to/certificate.crt
# SSLCertificateKeyFile /path/to/private.key
# SSLCertificateChainFile /path/to/chain.crt

# Security Headers
{% if enable_hsts %}
Header always set Strict-Transport-Security "max-age={{ hsts_max_age }}; includeSubDomains"
{% endif %}
Header always set X-Frame-Options DENY
Header always set X-Content-Type-Options nosniff

# SSL Session Configuration
SSLSessionCache shmcb:/var/cache/mod_ssl/scache(512000)
SSLSessionCacheTimeout 300

# Disable SSL compression (CRIME attack mitigation)
SSLCompression off

# OCSP Stapling (if supported)
SSLUseStapling on
SSLStaplingCache shmcb:/var/run/ocsp(128000)