# Redis configuration file
# Generated by Ansible

# Network
bind 127.0.0.1
port {{ cache_redis_port }}

# General
daemonize yes
supervised systemd
pidfile /var/run/redis/redis-server.pid

# Logging
loglevel notice
logfile {{ cache_redis_log_dir }}/redis_{{ cache_redis_port }}.log

# Snapshotting
save 900 1
save 300 10
save 60 10000

# Database
dir /var/lib/redis
dbfilename dump.rdb

# Security
requirepass {{ cache_redis_password }}

# Memory management
maxmemory-policy allkeys-lru

# Append only file
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec