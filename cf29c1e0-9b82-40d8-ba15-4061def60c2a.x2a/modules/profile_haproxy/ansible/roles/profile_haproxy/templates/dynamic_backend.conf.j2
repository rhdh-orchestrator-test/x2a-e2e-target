# Backend: {{ backend_name }}
# Managed by Ansible — dynamic discovery

backend {{ backend_name }}
    balance {{ balance }}
{% if health_check is defined %}
    option  {{ health_check }}
{% endif %}
{% if health_interval is defined %}
    default-server inter {{ health_interval }}
{% endif %}
{% for server_ip in servers %}
    server {{ backend_name }}-{{ loop.index }} {{ server_ip }}:{{ backend_port }} check weight 100{% if ssl_enabled %} ssl verify none{% endif %}
{% endfor %}