# Redis configuration file
# Generated by Ansible

# Network
port {{ cache_redis_port }}
bind {{ cache_redis_bind }}

# General
daemonize yes
pidfile /var/run/redis/redis-server.pid
loglevel notice
logfile {{ cache_redis_log_file }}

# Persistence
dir {{ cache_redis_data_dir }}
dbfilename dump.rdb
save 900 1
save 300 10
save 60 10000
rdbcompression yes

# Memory management
databases 16
maxmemory-policy allkeys-lru

# Security
protected-mode yes