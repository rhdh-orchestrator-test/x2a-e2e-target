# Redis configuration file
# Generated by Ansible - do not edit manually

# Network configuration
bind {{ cache_redis_bind }}
port {{ cache_redis_port }}

# General configuration
daemonize yes
supervised systemd
pidfile /var/run/redis/redis-server.pid

# Logging
loglevel notice
logfile {{ cache_redis_log_file }}

# Data persistence
dir {{ cache_redis_data_dir }}
dbfilename dump.rdb
save 900 1
save 300 10
save 60 10000

# Security
protected-mode yes

# Memory management
maxmemory-policy allkeys-lru

# Append only file
appendonly no