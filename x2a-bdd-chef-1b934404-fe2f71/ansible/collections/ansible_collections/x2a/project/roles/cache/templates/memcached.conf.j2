# Memcached configuration generated by the cache role.
PORT="{{ cache_memcached_port }}"
USER="{{ cache_memcached_user }}"
MAXCONN="{{ cache_memcached_maxconn }}"
CACHESIZE="{{ cache_memcached_memory }}"
OPTIONS="-U {{ cache_memcached_udp_port }} -l {{ cache_memcached_listen }} -I {{ cache_memcached_max_object_size }} -t {{ cache_memcached_threads }}{% for option in cache_memcached_experimental_options %} {{ option }}{% endfor %}{% for option in cache_memcached_extra_cli_options %} {{ option }}{% endfor %}"
