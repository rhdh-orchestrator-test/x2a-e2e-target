# Redis server default configuration
# Managed by Ansible

# Redis server user
REDIS_USER=redis

# Redis server configuration file
REDIS_CONFIG=/etc/redis/redis.conf

# Redis server PID file
REDIS_PID=/var/run/redis/redis-server.pid

# Redis server log file
REDIS_LOG=/var/log/redis/redis-server.log

# Additional options
REDIS_OPTS=""