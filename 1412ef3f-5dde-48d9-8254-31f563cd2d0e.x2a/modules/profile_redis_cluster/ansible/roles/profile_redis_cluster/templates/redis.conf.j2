# Redis configuration — Managed by Ansible
# Node: {{ ansible_facts['fqdn'] }}

bind {{ profile_redis_cluster_bind }}
port {{ profile_redis_cluster_redis_port }}
daemonize yes
pidfile /var/run/redis/redis-server.pid
logfile /var/log/redis/redis-server.log
loglevel notice

# Security
requirepass {{ redis_password }}

# Persistence
appendonly {{ profile_redis_cluster_appendonly | lower }}
appendfilename "appendonly.aof"
appendfsync {{ profile_redis_cluster_appendfsync }}
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# RDB snapshots
save 900 1
save 300 10
save 60 10000
dbfilename dump.rdb
dir /var/lib/redis

# Memory
maxmemory {{ profile_redis_cluster_maxmemory_mb }}mb
maxmemory-policy {{ profile_redis_cluster_maxmemory_policy }}

# Network
tcp-backlog 511
timeout 0
tcp-keepalive 300