[Unit]
Description=FastAPI Tutorial Service
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory={{ fastapi_tutorial_app_dir }}
Environment="PATH={{ fastapi_tutorial_venv_dir }}/bin"
ExecStart={{ fastapi_tutorial_venv_dir }}/bin/uvicorn app.main:app --host {{ fastapi_tutorial_app_host }} --port {{ fastapi_tutorial_app_port }}
Restart=always

[Install]
WantedBy=multi-user.target
