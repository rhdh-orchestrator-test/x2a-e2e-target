# Redis configuration file
# Generated by Ansible

# Network
bind 127.0.0.1
port 6379

# General
daemonize yes
pidfile /var/run/redis/redis-server.pid

# Memory management
maxmemory 256mb
maxmemory-policy allkeys-lru

# Logging
logfile /var/log/redis/redis-server.log

# Persistence
dir /var/lib/redis
dbfilename dump.rdb