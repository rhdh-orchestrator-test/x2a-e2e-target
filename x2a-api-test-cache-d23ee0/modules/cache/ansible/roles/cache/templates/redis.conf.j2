# Redis configuration file
# Generated by Ansible

# Network
bind {{ cache_redis_bind }}
port {{ cache_redis_port }}

# General
daemonize yes
supervised systemd
pidfile /var/run/redis/redis-server.pid

# Logging
loglevel notice
logfile {{ cache_redis_log_dir }}/redis.log

# Persistence
save 900 1
save 300 10
save 60 10000

dir /var/lib/redis

# Security
requirepass {{ redis_password }}

# Memory management
maxmemory-policy allkeys-lru

# Append only file
appendonly yes
appendfilename "appendonly.aof"

# Slow log
slowlog-log-slower-than 10000
slowlog-max-len 128

# Client timeout
timeout 0
tcp-keepalive 300

# Database
databases 16