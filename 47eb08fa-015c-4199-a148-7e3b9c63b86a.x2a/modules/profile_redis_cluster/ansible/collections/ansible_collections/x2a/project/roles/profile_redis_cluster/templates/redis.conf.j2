bind {{ redis_cluster_bind }}
protected-mode yes
port {{ redis_cluster_redis_port }}
tcp-backlog 511
timeout 0
tcp-keepalive 0
daemonize {{ 'yes' if redis_cluster_daemonize else 'no' }}
pidfile {{ redis_cluster_pid_file }}
loglevel notice
logfile {{ redis_cluster_log_file }}
databases 16
always-show-logo no
set-proc-title yes
proc-title-template "{title} ({listen-addr}:{port}) {server-mode}"
stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
dir {{ redis_cluster_data_dir }}
save 900 1
save 300 10
save 60 10000
appendonly {{ 'yes' if redis_cluster_appendonly else 'no' }}
appendfilename appendonly.aof
appendfsync {{ redis_cluster_appendfsync }}
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb
requirepass {{ redis_cluster_redis_password }}
maxmemory {{ redis_cluster_maxmemory_mb }}mb
maxmemory-policy {{ redis_cluster_maxmemory_policy }}
unixsocket {{ redis_cluster_unix_socket }}
unixsocketperm 0755
cluster-enabled {{ 'yes' if redis_cluster_cluster_enabled else 'no' }}
