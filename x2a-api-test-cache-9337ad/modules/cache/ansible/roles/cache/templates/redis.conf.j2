# Redis configuration file
# Generated by Ansible

# Network
bind {{ cache_redis_bind }}
port {{ cache_redis_port }}
timeout {{ cache_redis_timeout }}
tcp-keepalive {{ cache_redis_tcp_keepalive }}

# General
loglevel {{ cache_redis_loglevel }}
logfile {{ cache_redis_logfile }}
databases {{ cache_redis_databases }}

# Authentication
requirepass {{ redis_password }}

# Snapshotting
{% for save_rule in cache_redis_save %}
save {{ save_rule }}
{% endfor %}
stop-writes-on-bgsave-error {{ cache_redis_stop_writes_on_bgsave_error | lower }}
rdbcompression {{ cache_redis_rdbcompression | lower }}
rdbchecksum {{ cache_redis_rdbchecksum | lower }}
dbfilename {{ cache_redis_dbfilename }}
dir {{ cache_redis_dir }}

# Memory management
maxmemory-policy {{ cache_redis_maxmemory_policy }}

# Disable dangerous commands
rename-command FLUSHDB ""
rename-command FLUSHALL ""
rename-command DEBUG ""
rename-command CONFIG ""