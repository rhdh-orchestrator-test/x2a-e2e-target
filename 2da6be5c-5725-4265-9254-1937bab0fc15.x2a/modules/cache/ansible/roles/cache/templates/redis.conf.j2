# Redis configuration file
# Generated by Ansible

# Network
bind {{ cache_redis_bind }}
port {{ cache_redis_port }}

# General
daemonize yes
supervised systemd
pidfile /var/run/redis/redis-server.pid

# Logging
loglevel notice
logfile {{ cache_redis_log_file }}

# Persistence
dir {{ cache_redis_data_dir }}
save 900 1
save 300 10
save 60 10000

# Security
protected-mode yes

# Memory management
maxmemory-policy allkeys-lru

# Append only file
appendonly yes
appendfilename "appendonly.aof"