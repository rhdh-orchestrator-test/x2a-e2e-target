# Chef Automate Configuration Template
# Generated by Ansible

[global.v1]
fqdn = "{{ chef_hostname | default(ansible_facts['fqdn']) }}"

[global.v1.frontend_tls]
# SSL/TLS Configuration
cert = "{{ apache_ssl_cert_path | default('/hab/svc/automate-load-balancer/data/server.crt') }}"
key = "{{ apache_ssl_key_path | default('/hab/svc/automate-load-balancer/data/server.key') }}"

[auth_n.v1.sys.service]
# Authentication service configuration
a1_data_collector_token = ""

[deployment.v1.sys.service]
# Deployment service configuration
channel = "current"
upgrade_strategy = "at-once"

[load_balancer.v1.sys.service]
# Load balancer configuration
external_fqdn = "{{ chef_hostname | default(ansible_facts['fqdn']) }}"

{% if 'infra-server' in chef_products %}
[chef_server.v1.sys.service]
# Chef Infra Server configuration
external_fqdn = "{{ chef_hostname | default(ansible_facts['fqdn']) }}"
{% endif %}

[postgresql.v1.sys.service]
# PostgreSQL configuration
enable = true

[elasticsearch.v1.sys.service]
# Elasticsearch configuration
enable = true

[compliance.v1.sys.service]
# Compliance service configuration
enable = true

[ingest.v1.sys.service]
# Ingest service configuration
enable = true

[data_feed.v1.sys.service]
# Data feed service configuration
enable = true