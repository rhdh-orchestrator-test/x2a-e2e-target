# Redis configuration file for port {{ cache_redis_port }}
# Generated by Ansible

# Network
bind 127.0.0.1
port {{ cache_redis_port }}

# General
daemonize yes
pidfile /var/run/redis/redis_{{ cache_redis_port }}.pid
loglevel notice
logfile {{ cache_redis_log_dir }}/redis_{{ cache_redis_port }}.log

# Snapshotting
save 900 1
save 300 10
save 60 10000

# Database
databases 16

# Security
requirepass {{ redis_password }}

# Memory management
maxmemory-policy allkeys-lru

# Append only file
appendonly yes
appendfilename "appendonly_{{ cache_redis_port }}.aof"

# Slow log
slowlog-log-slower-than 10000
slowlog-max-len 128

# Client output buffer limits
client-output-buffer-limit normal 0 0 0
client-output-buffer-limit slave 256mb 64mb 60
client-output-buffer-limit pubsub 32mb 8mb 60