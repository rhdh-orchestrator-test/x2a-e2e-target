# Redis configuration file
# Generated by Ansible

# Network configuration
bind 127.0.0.1
port {{ cache_redis_port }}

# General configuration
daemonize yes
supervised systemd
pidfile /var/run/redis/redis-server.pid

# Logging
loglevel notice
logfile {{ cache_redis_log_dir }}/redis-server.log

# Data persistence
dir /var/lib/redis
dbfilename dump.rdb
save 900 1
save 300 10
save 60 10000

# Security - Authentication
requirepass {{ redis_password }}

# Memory management
maxmemory-policy allkeys-lru

# Append only file
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec

# Slow log
slowlog-log-slower-than 10000
slowlog-max-len 128

# Client timeout
timeout 0
tcp-keepalive 300

# Database count
databases 16