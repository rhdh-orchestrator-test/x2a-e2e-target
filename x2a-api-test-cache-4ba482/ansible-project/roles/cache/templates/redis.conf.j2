# Redis configuration file
# Generated by Ansible

# Network
port {{ cache_redis_port }}
bind {{ cache_redis_bind }}
timeout {{ cache_redis_timeout }}
tcp-keepalive {{ cache_redis_tcp_keepalive }}

# General
daemonize yes
supervised systemd
pidfile /var/run/redis/redis-server.pid
loglevel {{ cache_redis_log_level }}
logfile /var/log/redis/redis_{{ cache_redis_port }}.log
databases {{ cache_redis_databases }}

# Authentication
requirepass {{ redis_password }}

# Memory management
maxmemory {{ cache_redis_maxmemory }}
maxmemory-policy {{ cache_redis_maxmemory_policy }}

# Persistence
{% if cache_redis_save_enabled %}
{% for interval in cache_redis_save_intervals %}
save {{ interval }}
{% endfor %}
{% else %}
save ""
{% endif %}

stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
dir /var/lib/redis

# Replication
# replica-serve-stale-data and other replica settings are intentionally omitted
# as they are cleaned up by the configuration cleanup task

# Security
protected-mode yes

# Clients
maxclients 10000

# Slow log
slowlog-log-slower-than 10000
slowlog-max-len 128

# Latency monitor
latency-monitor-threshold 100